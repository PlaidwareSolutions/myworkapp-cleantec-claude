# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing secret (required in production; generate with: openssl rand -hex 32)
JWT_SECRET=

# Port the server listens on (Railway injects this automatically)
PORT=5000

# SMTP email notifications (optional; emails are skipped if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
